SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/volunteer_service?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8mb4
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false

# 生产/正式验收建议保持 false；课程演示需要默认账号时可改为 true。
VMS_BOOTSTRAP_ENABLED=false
VMS_BOOTSTRAP_ADMIN_USERNAME=admin
VMS_BOOTSTRAP_ADMIN_PASSWORD=admin123
VMS_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
VMS_BOOTSTRAP_ORGANIZER_USERNAME=organizer
VMS_BOOTSTRAP_ORGANIZER_PASSWORD=organizer123
VMS_BOOTSTRAP_ORGANIZER_DISPLAY_NAME=组织方账号

VMS_FILE_STORAGE_DIR=./uploads
VMS_FILE_IMAGE_MAX_BYTES=5242880
VMS_FILE_ATTACHMENT_MAX_BYTES=52428800

VMS_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173
VMS_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
VMS_CORS_ALLOWED_HEADERS=Authorization,Content-Type
VMS_CORS_ALLOW_CREDENTIALS=false

VMS_JWT_SECRET=please_change_this_to_a_random_secret_at_least_32_chars
VMS_JWT_TTL_SECONDS=86400
VMS_JWT_ISSUER=volunteer-service

# 真实邮箱发送配置。默认 false 时 EMAIL/SMS 均使用课程版模拟发送。
# 当前系统复用 username 作为邮件收件地址；需要真实发送时，请让接收用户使用邮箱格式用户名注册。
# 常见 SSL 465：VMS_EMAIL_SSL_ENABLED=true，VMS_EMAIL_STARTTLS_ENABLED=false。
# 常见 STARTTLS 587：VMS_EMAIL_SSL_ENABLED=false，VMS_EMAIL_STARTTLS_ENABLED=true。
VMS_EMAIL_ENABLED=false
VMS_EMAIL_HOST=smtp.example.com
VMS_EMAIL_PORT=465
VMS_EMAIL_USERNAME=your_email_account
VMS_EMAIL_PASSWORD=your_email_authorization_code
VMS_EMAIL_FROM=your_email_account@example.com
VMS_EMAIL_FROM_NAME=志愿者服务管理系统
VMS_EMAIL_AUTH=true
VMS_EMAIL_SSL_ENABLED=true
VMS_EMAIL_STARTTLS_ENABLED=false
VMS_EMAIL_CONNECTION_TIMEOUT_MILLIS=10000
VMS_EMAIL_TIMEOUT_MILLIS=10000
VMS_EMAIL_WRITE_TIMEOUT_MILLIS=10000
