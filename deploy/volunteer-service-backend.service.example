[Unit]
Description=Volunteer Service Management Backend
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=volunteer
Group=volunteer
WorkingDirectory=/opt/volunteer-service/backend
EnvironmentFile=/opt/volunteer-service/backend/.env
ExecStart=/usr/bin/java -jar /opt/volunteer-service/backend/volunteer-service-backend.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/volunteer-service/backend/uploads

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
